PORT=3000

# General, platform-level code that gates creating an account AT ALL on
# this server. NOT tied to any specific campaign/session — think of it as
# "you're allowed to have a vault here", separate from "which campaign
# you're in" (that's a session's own invite code, generated by the app).
SIGNUP_CODE=change-me-before-deploying

# Max characters any one player can have within a single session.
MAX_CHARACTERS_PER_SESSION=6

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too
